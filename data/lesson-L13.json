  "grammar": [
    {
      "h": "從て形換一個字",
      "form": "ta",
      "p": [
        "た形是て形的過去版：語尾「て」換「た」、「で」換「だ」，所以五段動詞看下表「音便」那一列（紅框）＝会った・書いた・泳いだ・話した・待った・死んだ・遊んだ・読んだ・帰った。",
        "形容詞和名詞另有自己的過去形，見第三張表。"
      ],
      "ex": [
        {
          "ja": "昨日、友達と遊んだ。",
          "zh": "昨天和朋友玩了。",
          "kana": "きのう、ともだちとあそんだ。",
          "hl": [
            "遊んだ"
          ]
        },
        {
          "ja": "仕事が終わったあとで、飲みに行きましょう。",
          "zh": "工作結束之後，一起去喝酒吧！",
          "kana": "しごとがおわったあとで、のみにいきましょう。",
          "hl": [
            "終わったあとで"
          ]
        },
        {
          "ja": "これは日本で買ったTシャツです。",
          "zh": "這是在日本買的T恤。",
          "kana": "これはにほんでかったティーシャツです。",
          "hl": [
            "買った"
          ]
        },
        {
          "ja": "大学に合格したとき、とてもうれしかったです。",
          "zh": "大學錄取的時候，非常開心。",
          "kana": "だいがくにごうかくしたとき、とてもうれしかったです。",
          "hl": [
            "うれしかった"
          ]
        }
      ],

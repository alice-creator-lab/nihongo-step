{
  "id": "L13",
  "book": 2,
  "no": 13,
  "title": "た形與列舉",
  "titleJa": "た形と並べ方",
  "level": "N5",
  "goal": "用た形說過去的事，並用「たり」「や」「ながら」把多個動作或名詞並列起來，讓敘述更自然。",
  "patterns": [
    {
      "ja": "～ました／た形",
      "form": "ta",
      "zh": "做了～（過去）",
      "note": "丁寧體用「ました」，普通體用た形。た形的做法和て形一樣，只要把「て」換成「た」、「で」換成「だ」。",
      "ex": [
        {
          "ja": "昨日、映画を見た。",
          "zh": "昨天看了電影。",
          "kana": "きのう、えいがをみた。"
        },
        {
          "ja": "先週、友達と海へ行きました。",
          "zh": "上週和朋友去了海邊。",
          "kana": "せんしゅう、ともだちとうみへいきました。"
        }
      ]
    },
    {
      "ja": "～たり～たりします",
      "form": "ta",
      "zh": "一下～一下～（舉幾個代表性動作）",
      "note": "從一連串動作中挑幾項來說，順序不重要。前面動詞用た形加「り」，句尾常用「します／しました」；依句型也可以是「している」「だ」等述語。",
      "ex": [
        {
          "ja": "週末は掃除したり、洗濯したりします。",
          "zh": "週末打掃、洗衣服等等。",
          "kana": "しゅうまつはそうじしたり、せんたくしたりします。"
        },
        {
          "ja": "日曜日は本を読んだり、音楽を聞いたりします。",
          "zh": "星期天看看書、聽聽音樂。",
          "kana": "にちようびはほんをよんだり、おんがくをきいたりします。"
        }
      ]
    },
    {
      "ja": "～や～など",
      "zh": "～和～等等（不完全列舉）",
      "note": "「や」只舉出幾項，暗示還有其他；「など」放在最後收尾。若要全部列出，用「と」。",
      "ex": [
        {
          "ja": "かばんの中に鍵や財布などがあります。",
          "zh": "包包裡有鑰匙、錢包之類的東西。",
          "kana": "かばんのなかにかぎやさいふなどがあります。"
        },
        {
          "ja": "夏休みに海や山へ行きました。",
          "zh": "暑假期間去了海邊、山上等地方。",
          "kana": "なつやすみにうみややまへいきました。"
        }
      ]
    },
    {
      "ja": "～てから",
      "form": "te",
      "zh": "～之後（才）",
      "note": "強調前一個動作先完成，後面的動作才開始。前面用て形，主句放後面。",
      "ex": [
        {
          "ja": "宿題をしてから、ゲームをします。",
          "zh": "寫完作業再玩遊戲。",
          "kana": "しゅくだいをしてから、ゲームをします。"
        },
        {
          "ja": "シャワーを浴びてから、寝ます。",
          "zh": "洗完澡才睡覺。",
          "kana": "シャワーをあびてから、ねます。"
        }
      ]
    },
    {
      "ja": "～たあとで",
      "form": "ta",
      "zh": "～之後",
      "note": "動詞た形＋あとで，名詞則用「～のあとで」。語氣比「てから」中性，只交代先後。",
      "ex": [
        {
          "ja": "仕事が終わったあとで、泳ぎに行きます。",
          "zh": "工作結束後去游泳。",
          "kana": "しごとがおわったあとで、およぎにいきます。"
        },
        {
          "ja": "昼ごはんを食べたあとで、散歩します。",
          "zh": "吃完午飯後散步。",
          "kana": "ひるごはんをたべたあとで、さんぽします。"
        }
      ]
    },
    {
      "ja": "～ながら",
      "form": "masu",
      "zh": "一邊～一邊～",
      "note": "前面動詞用ます形去「ます」加「ながら」，表示同時進行。主要動作放在句尾。",
      "ex": [
        {
          "ja": "音楽を聞きながら、宿題をします。",
          "zh": "一邊聽音樂一邊寫作業。",
          "kana": "おんがくをききながら、しゅくだいをします。"
        },
        {
          "ja": "コーヒーを飲みながら、新聞を読みます。",
          "zh": "一邊喝咖啡一邊看報紙。",
          "kana": "コーヒーをのみながら、しんぶんをよみます。"
        }
      ]
    }
  ],

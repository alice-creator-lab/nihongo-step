{
  "id": "L04",
  "book": 1,
  "no": 4,
  "title": "數字與購物",
  "titleJa": "いくらですか",
  "level": "N5",
  "goal": "看懂價格並說出「～円」，用「いくらですか」問價錢，用「～をください」和數量詞完成買東西的對話。",
  "patterns": [
    {
      "ja": "～はいくらですか",
      "zh": "～多少錢？",
      "note": "「いくら」是問價格的疑問詞，位置和一般疑問詞一樣，放在「は」後面。",
      "ex": [
        {
          "ja": "これはいくらですか。",
          "zh": "這個多少錢？",
          "kana": "これはいくらですか。"
        },
        {
          "ja": "その傘はいくらですか。",
          "zh": "那把傘多少錢？",
          "kana": "そのかさはいくらですか。"
        }
      ]
    },
    {
      "ja": "～は～円です",
      "zh": "～是～日圓",
      "note": "價格說「數字＋円（えん）」。口語中常省略「一」，直接說「百円」＝一百日圓。",
      "ex": [
        {
          "ja": "これは百円です。",
          "zh": "這個一百日圓。",
          "kana": "これはひゃくえんです。"
        },
        {
          "ja": "あの傘は千円です。",
          "zh": "那把傘一千日圓。",
          "kana": "あのかさはせんえんです。"
        }
      ]
    },
    {
      "ja": "～をください",
      "zh": "請給我～",
      "note": "「を」標示想要的東西，「ください」是請託。這是買東西最實用的句型，語氣禮貌且不卑不亢。",
      "ex": [
        {
          "ja": "これをください。",
          "zh": "請給我這個。",
          "kana": "これをください。"
        },
        {
          "ja": "コーヒーをください。",
          "zh": "請給我一杯咖啡。",
          "kana": "コーヒーをください。"
        }
      ]
    },
    {
      "ja": "數量詞：ひとつ・ふたつ・みっつ",
      "zh": "一個・兩個・三個",
      "note": "日語的數量詞放在「を」後面、動詞前面：「りんごをふたつください」。",
      "ex": [
        {
          "ja": "りんごをふたつください。",
          "zh": "請給我兩個蘋果。",
          "kana": "りんごをふたつください。"
        },
        {
          "ja": "お茶をひとつください。",
          "zh": "請給我一杯茶。",
          "kana": "おちゃをひとつください。"
        }
      ]
    },
    {
      "ja": "～も～です／～もください",
      "zh": "～也是～／也請給我～",
      "note": "買東西時用「も」追加：「これもください」＝這個也要。比逐一說「これをください」自然。",
      "ex": [
        {
          "ja": "これもください。",
          "zh": "這個也請給我。",
          "kana": "これもください。"
        },
        {
          "ja": "あれも百円です。",
          "zh": "那個也是一百日圓。",
          "kana": "あれもひゃくえんです。"
        }
      ]
    },
    {
      "ja": "じゃ、～をお願いします",
      "zh": "那麼，麻煩你～",
      "note": "「じゃ」是「では」的口語，用於決定下一步。「お願いします」比「ください」更客氣，結帳時很常用。",
      "ex": [
        {
          "ja": "じゃ、これをお願いします。",
          "zh": "那麼，就這個麻煩你。",
          "kana": "じゃ、これをおねがいします。"
        },
        {
          "ja": "カードでお願いします。",
          "zh": "請用信用卡（付款）。",
          "kana": "カードでおねがいします。"
        }
      ]
    }
  ],

  "grammar": [
    {
      "h": "「時」的讀法有三個例外",
      "p": [
        "基本原則是數字加「じ」：三時（さんじ）、五時（ごじ）、十時（じゅうじ）。",
        "三個例外要背：四時讀「よじ」（不是「しじ」），七時讀「しちじ」（不是「ななじ」），九時讀「くじ」（不是「きゅうじ」）。",
        "四和七容易聽混，所以這兩個讀法特別重要；打電話或約時間說錯，對方可能直接誤會。"
      ],
      "ex": [
        {
          "ja": "四時です。",
          "zh": "四點。",
          "kana": "よじです。"
        },
        {
          "ja": "七時からです。",
          "zh": "從七點開始。",
          "kana": "しちじからです。"
        }
      ]
    },
    {
      "h": "「分」的讀法會促音化",
      "p": [
        "一分、六分、八分、十分讀「いっぷん、ろっぷん、はっぷん、じゅっぷん」，中間出現小っ。",
        "三分、四分、二十五分則讀「さんぷん、よんぷん、にじゅうごふん」，依前面的數字變化。",
        "最實用的做法是先記十五分（じゅうごふん）、三十分（さんじゅっぷん）、四十五分（よんじゅうごふん）這三個刻度，其餘再慢慢補。"
      ],
      "ex": [
        {
          "ja": "三時五分です。",
          "zh": "三點五分。",
          "kana": "さんじごふんです。"
        },
        {
          "ja": "六時十五分です。",
          "zh": "六點十五分。",
          "kana": "ろくじじゅうごふんです。"
        }
      ]
    },
    {
      "h": "「半」＝三十分",
      "p": [
        "「～時半」就是「～點三十分」，口語比「～時三十分」自然得多。",
        "「半」只能接在「時」後面，不能單獨說「半です」；要說「二時半です」。",
        "超過半小時通常改說「～時～分」，例如「二時四十分」，不說「三時前二十分」。"
      ],
      "ex": [
        {
          "ja": "八時半です。",
          "zh": "八點半。",
          "kana": "はちじはんです。"
        },
        {
          "ja": "十二時半です。",
          "zh": "十二點半。",
          "kana": "じゅうにじはんです。"
        }
      ]
    },
    {
      "h": "午前・午後・朝・昼・夜",
      "p": [
        "「午前」與「午後」以中午十二點為界，是比較中性的說法，天氣預報、時刻表都用這組。",
        "「朝・昼・夜」帶有生活作息的味道：「朝」大約指起床到十點，「昼」是中午前後，「夜」是天黑之後。",
        "「今日・明日・昨日」常和這些詞搭配：「明日の朝」「昨日の夜」，中間要加「の」。"
      ],
      "ex": [
        {
          "ja": "午前十時です。",
          "zh": "上午十點。",
          "kana": "ごぜんじゅうじです。"
        },
        {
          "ja": "夜八時です。",
          "zh": "晚上八點。",
          "kana": "よるはちじです。"
        }
      ]
    },
    {
      "h": "「から」與「まで」",
      "p": [
        "「から」表示起點，「まで」表示終點，兩者都能接在時間名詞後面，不需要動詞。",
        "只說「九時からです」也能成句，意思是「從九點開始」；「九時までです」則是「到九點為止」。",
        "問句把對應的部分換成疑問詞：「何時からですか」「何時までですか」，回答時保留「から」「まで」即可。"
      ],
      "ex": [
        {
          "ja": "会議は三時から四時までです。",
          "zh": "會議從三點到四點。",
          "kana": "かいぎはさんじからよじまでです。"
        },
        {
          "ja": "仕事は九時からです。",
          "zh": "工作從九點開始。",
          "kana": "しごとはくじからです。"
        }
      ]
    },
    {
      "h": "問時間：何時ですか",
      "p": [
        "「何時」讀「なんじ」，不讀「なにじ」。這是最常用的問時間句型，省略主語也聽得懂。",
        "要問某件事的時間，就把那件事當主題：「授業は何時からですか」。",
        "回答時直接說鐘點，句尾加「です」：「九時からです」。不必重複整個問句。"
      ],
      "ex": [
        {
          "ja": "今、何時ですか。",
          "zh": "現在幾點？",
          "kana": "いま、なんじですか。"
        },
        {
          "ja": "会議は何時までですか。",
          "zh": "會議到幾點？",
          "kana": "かいぎはなんじまでですか。"
        }
      ]
    },
    {
      "h": "指路的三個詞：まっすぐ・右・左",
      "p": [
        "「まっすぐ」是直走、「右」是右邊、「左」是左邊；「角」是轉角，常說「あの角」「次の角」。",
        "先用「～はどこですか」問位置，再用「～の右です」「まっすぐです」回答，這兩句都不需要動詞。",
        "加上「あの」可以指較遠的地標：「あの角の右」「あの銀行の隣」，比單純說「右」清楚。"
      ],
      "ex": [
        {
          "ja": "まっすぐです。",
          "zh": "直走就到了。",
          "kana": "まっすぐです。"
        },
        {
          "ja": "角の左です。",
          "zh": "轉角的左邊。",
          "kana": "かどのひだりです。"
        }
      ]
    }
  ],

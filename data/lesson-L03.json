{
  "id": "L03",
  "book": 1,
  "no": 3,
  "title": "時間與方向",
  "titleJa": "なんじですか",
  "level": "N5",
  "goal": "會看鐘點說出「～時～分」，用「から・まで」說明時間範圍，並用「まっすぐ・右・左・角」為別人指路。",
  "patterns": [
    {
      "ja": "今、～時です",
      "zh": "現在是～點",
      "note": "「今」讀「いま」。鐘點說法為「數字＋時（じ）」，四點讀「よじ」、七點讀「しちじ」、九點讀「くじ」。",
      "ex": [
        {
          "ja": "今、三時です。",
          "zh": "現在三點。",
          "kana": "いま、さんじです。"
        },
        {
          "ja": "今、九時です。",
          "zh": "現在九點。",
          "kana": "いま、くじです。"
        }
      ]
    },
    {
      "ja": "～時～分です／～時半です",
      "zh": "～點～分／～點半",
      "note": "「半」是「はん」，接在「時」後面表示三十分，不必再說「三十分」。",
      "ex": [
        {
          "ja": "七時十五分です。",
          "zh": "七點十五分。",
          "kana": "しちじじゅうごふんです。"
        },
        {
          "ja": "二時半です。",
          "zh": "兩點半。",
          "kana": "にじはんです。"
        }
      ]
    },
    {
      "ja": "午前／午後の～時",
      "zh": "上午／下午的～點",
      "note": "「午前」是中午前，「午後」是中午後。十二小時制在口語中很常見，正式場合才用二十四小時制。",
      "ex": [
        {
          "ja": "会議は午後二時からです。",
          "zh": "會議從下午兩點開始。",
          "kana": "かいぎはごごにじからです。"
        },
        {
          "ja": "授業は午前九時です。",
          "zh": "課程在上午九點。",
          "kana": "じゅぎょうはごぜんくじです。"
        }
      ]
    },
    {
      "ja": "～から～までです",
      "zh": "從～到～",
      "note": "「から」標起點，「まで」標終點，兩者都可以單獨使用；省略的一端由上下文補足。",
      "ex": [
        {
          "ja": "仕事は九時から五時までです。",
          "zh": "工作從九點到五點。",
          "kana": "しごとはくじからごじまでです。"
        },
        {
          "ja": "学校は八時半から三時までです。",
          "zh": "學校從八點半到三點。",
          "kana": "がっこうははちじはんからさんじまでです。"
        }
      ]
    },
    {
      "ja": "～は何時（から）ですか",
      "zh": "～是幾點（開始）？",
      "note": "問鐘點用「何時（なんじ）」。「何時から」問開始時間，「何時まで」問結束時間。",
      "ex": [
        {
          "ja": "今、何時ですか。",
          "zh": "現在幾點？",
          "kana": "いま、なんじですか。"
        },
        {
          "ja": "授業は何時からですか。",
          "zh": "課程從幾點開始？",
          "kana": "じゅぎょうはなんじからですか。"
        }
      ]
    },
    {
      "ja": "まっすぐ・右・左・角",
      "zh": "直走・右邊・左邊・轉角",
      "note": "指路時用名詞句就好：「あの角の右です」。移動動詞留到後面的課，先記住這幾個位置詞。",
      "ex": [
        {
          "ja": "トイレはあの角の右です。",
          "zh": "廁所在那個轉角的右邊。",
          "kana": "トイレはあのかどのみぎです。"
        },
        {
          "ja": "駅はまっすぐです。",
          "zh": "車站就在前面直走的方向。",
          "kana": "えきはまっすぐです。"
        }
      ]
    }
  ],

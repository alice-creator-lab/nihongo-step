  "grammar": [
    {
      "h": "三組動詞的變化",
      "form": "te",
      "ex": [
        {
          "ja": "朝ごはんを食べて、学校へ行きます。",
          "zh": "吃過早飯再去學校。",
          "kana": "あさごはんをたべて、がっこうへいきます。",
          "hl": [
            "食べて"
          ]
        },
        {
          "ja": "友達が来て、すぐに帰りました。",
          "zh": "朋友來了之後馬上就回去了。",
          "kana": "ともだちがきて、すぐにかえりました。",
          "hl": [
            "来て"
          ]
        }
      ],
      "tbl": [
        {
          "tight": true,
          "head": [
            "類別",
            "怎麼變",
            "例"
          ],
          "rows": [
            [
              "Ⅱ類（一段）",
              "去る＋て",
              "食べる→食べて"
            ],
            [
              "Ⅲ類（する）",
              "して",
              "する→して"
            ],
            [
              "Ⅲ類（来る）",
              "きて",
              "来る→きて"
            ]
          ]
        }
      ],
      "p": [
        "て形用來把兩件事連起來：先後（起きて、磨きます）、並列（安くて、おいしい）、原因（風邪をひいて、休みました）、附帶狀況（傘を持って出かけます）。"
      ]
    },
    {
      "h": "五段動詞：記語尾，不要記單字",
      "form": "te",
      "ex": [
        {
          "ja": "ここで少し待ってください。",
          "zh": "請在這裡稍等一下。",
          "kana": "ここですこしまってください。",
          "hl": [
            "待ってください"
          ]
        },
        {
          "ja": "名前を書いてください。",
          "zh": "請寫上名字。",
          "kana": "なまえをかいてください。",
          "hl": [
            "書いてください"
          ]
        }
      ],

{
  "id": "L12",
  "book": 2,
  "no": 12,
  "title": "て形與請求",
  "titleJa": "て形とお願い",
  "level": "N5",
  "goal": "掌握て形的三組變化，用「てください」請人做事，用「ています」說正在進行或持續的狀態。",
  "patterns": [
    {
      "ja": "～てください",
      "form": "te",
      "zh": "請你～",
      "note": "て形＋ください是最基本的請求句。對平輩、下屬、店員都可以用；對上司要換成更禮貌的說法。",
      "ex": [
        {
          "ja": "ここで待ってください。",
          "zh": "請在這裡等。",
          "kana": "ここでまってください。"
        },
        {
          "ja": "塩を取ってください。",
          "zh": "請把鹽遞過來。",
          "kana": "しおをとってください。"
        }
      ]
    },
    {
      "ja": "～ています（進行）",
      "form": "te",
      "zh": "正在～",
      "note": "て形＋います表示動作正在進行。常和「今」「～時」一起用。",
      "ex": [
        {
          "ja": "今、電車を待っています。",
          "zh": "現在正在等電車。",
          "kana": "いま、でんしゃをまっています。"
        },
        {
          "ja": "母は台所で料理を作っています。",
          "zh": "母親正在廚房做菜。",
          "kana": "はははだいどころでりょうりをつくっています。"
        }
      ]
    },
    {
      "ja": "～ています（狀態・習慣）",
      "form": "te",
      "zh": "持續～著／一直～",
      "note": "住む、結婚する、知る、持つ這類動詞用「ています」時，多表示動作留下來的結果狀態（住んでいる、結婚している、知っている），不是「正在做」。也有表示持續動作或習慣的用法，例如「教えています」「毎朝走っています」，要看動詞種類與語境。",
      "ex": [
        {
          "ja": "田中さんは東京に住んでいます。",
          "zh": "田中先生住在東京。",
          "kana": "たなかさんはとうきょうにすんでいます。"
        },
        {
          "ja": "わたしは大学で日本語を教えています。",
          "zh": "我在大學教日語。",
          "kana": "わたしはだいがくでにほんごをおしえています。"
        }
      ]
    },
    {
      "ja": "～て、～て（順序）",
      "form": "te",
      "zh": "～之後，再～",
      "note": "て形可以把幾個動作依發生順序串起來，最後一個動詞才決定時態與禮貌度。",
      "ex": [
        {
          "ja": "朝起きて、コーヒーを飲みます。",
          "zh": "早上起床，然後喝咖啡。",
          "kana": "あさおきて、コーヒーをのみます。"
        },
        {
          "ja": "宿題をして、それからテレビを見ます。",
          "zh": "做完功課，然後看電視。",
          "kana": "しゅくだいをして、それからテレビをみます。"
        }
      ]
    },
    {
      "ja": "～てくださいませんか",
      "form": "te",
      "zh": "能不能請你～？（較禮貌）",
      "note": "比「てください」客氣，帶有「徵求對方同意」的語氣，適合對長輩、客戶或不熟的人。",
      "ex": [
        {
          "ja": "この漢字の読み方を教えてくださいませんか。",
          "zh": "能不能請你教我這個漢字的讀法？",
          "kana": "このかんじのよみかたをおしえてくださいませんか。"
        },
        {
          "ja": "もう一度コピーしてくださいませんか。",
          "zh": "能不能請你再影印一次？",
          "kana": "もういちどコピーしてくださいませんか。"
        }
      ]
    },
    {
      "ja": "～て（手段・方法）",
      "form": "te",
      "zh": "用～的方式（去做）",
      "note": "て形也可以表示手段：走路去、搭電車去、用筷子吃。這種用法後面一定接移動或動作動詞。",
      "ex": [
        {
          "ja": "歩いて駅まで行きます。",
          "zh": "走路到車站。",
          "kana": "あるいてえきまでいきます。"
        },
        {
          "ja": "電車に乗って会社へ行きます。",
          "zh": "搭電車去公司。",
          "kana": "でんしゃにのってかいしゃへいきます。"
        }
      ]
    },
    {
      "ja": "～方（かた）",
      "form": "masu",
      "zh": "～的方法",
      "note": "ます形去掉ます＋方，把動作變成「方法」這個名詞：読み方、書き方、使い方。常配「～方を教えてください」。",
      "ex": [
        {
          "ja": "このアプリの使い方を教えてください。",
          "zh": "請告訴我這個應用程式怎麼用。",
          "kana": "このアプリのつかいかたをおしえてください。"
        },
        {
          "ja": "この漢字の読み方を教えてください。",
          "zh": "請告訴我這個漢字的讀法。",
          "kana": "このかんじのよみかたをおしえてください。"
        }
      ]
    }
  ],
